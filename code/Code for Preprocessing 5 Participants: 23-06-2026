avg_file = fullfile(workdir, ['maflp_fhp_dbe_' subj '_' runname '.mat']);

%% Update final bad-channel list in artefact-marked file
D_art = spm_eeg_load(art_file);

final_bad_labels = {'MEGXXXX','MEGXXXX'};  % EDIT

labels = chanlabels(D_art);
idx_final = find(ismember(labels, final_bad_labels));

