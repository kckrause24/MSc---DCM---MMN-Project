    'VariableNames', {'Index','ChannelLabel'}))

if numel(idx_final) ~= numel(final_bad_labels)
    error('Not all final bad-channel labels were found. Check labels before saving.');
end

D_art = badchannels(D_art, ':', 0);
D_art = badchannels(D_art, idx_final, 1);
save(D_art);

disp('Final bad channels saved in artefact-marked file:')
disp(chanlabels(D_art, badchannels(D_art))')

%% Delete previous averaged file before rerunning
[avg_path, avg_name, ~] = fileparts(avg_file);
avg_mat = fullfile(avg_path, [avg_name '.mat']);
avg_dat = fullfile(avg_path, [avg_name '.dat']);

