    delete(avg_mat);
    disp(['Deleted old average MAT file: ' avg_mat])
end

if exist(avg_dat, 'file')
    delete(avg_dat);
    disp(['Deleted old average DAT file: ' avg_dat])
end

%% Rerun robust averaging
S = [];
S.D = art_file;

S.robust = [];
S.robust.ks = 3;
S.robust.bycondition = 1;
S.robust.savew = 1;

S.removebad = 1;
