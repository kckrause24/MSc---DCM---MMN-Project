## 5. Baseline inversion setup code

```matlab
%% ========================================================================
% Day 3 Step 5 retry: baseline CMC DCM inversion with fiducial selection
% ========================================================================
% Retry after the first attempt failed during MEEG/MRI coregistration.
%
% Important interactive choices:
% Head model: template
% Cortical mesh: normal
% Nasion: select
% LPA: select
% RPA: select
%
% Do not choose skip for fiducials.
% ========================================================================

clear DCM;

baseline_ready_file = fullfile(day3_dir, ...
    'DCM_20HC_standard_pitch_CMC_6source_model12_BASELINE_READY_FOR_INVERSION.mat');

if ~exist(baseline_ready_file, 'file')
    error('Baseline ready file not found:\n%s', baseline_ready_file);
end

load(baseline_ready_file, 'DCM');

fprintf('\nLoaded baseline-ready DCM:\n%s\n', baseline_ready_file);

fprintf('\nReminder for SPM prompts:\n');
fprintf('Head model: template\n');
fprintf('Cortical mesh: normal\n');
fprintf('Nasion: select\n');
fprintf('LPA: select\n');
fprintf('RPA: select\n');
fprintf('Do not choose skip for fiducials.\n');

diary_file_retry = fullfile(day3_dir, ...
    'day3_baseline_inversion_retry_diary.txt');

diary(diary_file_retry);

try

    fprintf('\nStarting baseline CMC DCM inversion retry...\n');
    fprintf('Started at: %s\n', datestr(now));

    DCM = spm_dcm_erp(DCM);

    DCM.day3_status = 'Baseline CMC DCM inverted successfully after coregistration retry';
    DCM.day3_inversion_completed = true;
    DCM.day3_inversion_time = datestr(now);
    DCM.day3_baseline_model = true;
    DCM.day3_receptor_priors_used = false;
    DCM.day3_coregistration_note = ...
        'Retry used template head model, normal mesh, and selected fiducials rather than skipped fiducials.';

    inverted_dcm_file = fullfile(day3_dir, ...
        'DCM_20HC_standard_pitch_CMC_6source_model12_BASELINE_INVERTED.mat');

    save(inverted_dcm_file, 'DCM', '-v7.3');

    fprintf('\nBaseline CMC DCM inversion completed successfully.\n');
    fprintf('Finished at: %s\n', datestr(now));
    fprintf('\nInverted baseline DCM saved:\n%s\n', inverted_dcm_file);

    if isfield(DCM, 'F')
        fprintf('\nBaseline model free energy DCM.F:\n');
        disp(DCM.F);
    else
        warning('DCM.F was not found after inversion.');
    end

catch ME

    fprintf('\nBaseline DCM inversion retry failed.\n');
    fprintf('Error message:\n%s\n', ME.message);

    baseline_inversion_retry_error = ME;

    save(fullfile(day3_dir, 'day3_baseline_inversion_retry_error.mat'), ...
        'baseline_inversion_retry_error', 'DCM');

    diary off;

    rethrow(ME);

end

diary off;

fprintf('\nRetry diary saved:\n%s\n', diary_file_retry);
```

