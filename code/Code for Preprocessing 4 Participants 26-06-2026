## 5. Artefact rejection and condition count check

Edit `subj` and `threshold` for each participant.

```matlab
%% Step 3
% Run artefact rejection using participant-specific 97.5th percentile threshold

clear; clc;

%% Setup
restoredefaultpath
addpath(genpath('/Users/klauskrause/Documents/MATLAB/spm'))
spm('defaults','eeg')
spm_jobman('initcfg')

workdir = '/Users/klauskrause/Documents/MATLAB/ds004837_controls_spm';
cd(workdir);

subj = 'sub-XXXXA';
runname = 'run-01';

preqc_file = fullfile(workdir, ['flp_fhp_dbe_' subj '_' runname '.mat']);
art_file   = fullfile(workdir, ['aflp_fhp_dbe_' subj '_' runname '.mat']);

%% Confirm saved bad channels before artefact rejection
D = spm_eeg_load(preqc_file);

disp('Saved bad channels before artefact rejection:')
disp(chanlabels(D, badchannels(D))')

%% Artefact rejection threshold
threshold = 99999;

%% Run artefact rejection
S = [];
S.D = preqc_file;
S.mode = 'reject';
S.badchanthresh = 0.2;
S.append = true;

S.methods(1).channels = {'MEG'};
S.methods(1).fun = 'threshchan';
S.methods(1).settings.threshold = threshold;
S.methods(1).settings.excwin = 400;

S.prefix = 'a';

D_art = spm_eeg_artefact(S);

disp('Artefact-marked dataset created:')
disp(D_art)
disp(['Expected artefact-marked file: ' art_file])

%% Step 4
% Count bad trials overall and by condition

D_art = spm_eeg_load(art_file);

bt = badtrials(D_art);

if isnumeric(bt) && ~islogical(bt)
    tmp = false(D_art.ntrials,1);
    tmp(bt) = true;
    bt = tmp;
else
    bt = bt(:);
end

fprintf('\nTrial rejection summary for %s\n', subj)
fprintf('Threshold used: %d\n', threshold)
fprintf('Total trials: %d\n', D_art.ntrials)
fprintf('Bad trials: %d\n', sum(bt))
fprintf('Good trials: %d\n', sum(~bt))
fprintf('Percent rejected: %.2f%%\n', 100 * sum(bt) / D_art.ntrials)

conds = string(conditions(D_art))';
u = unique(conds);

bad_counts = zeros(numel(u),1);
good_counts = zeros(numel(u),1);
total_counts = zeros(numel(u),1);

for i = 1:numel(u)
    sel = conds == u(i);
    total_counts(i) = sum(sel);
    bad_counts(i) = sum(bt(sel));
    good_counts(i) = sum(sel & ~bt);
end

condition_table = table(u, total_counts, bad_counts, good_counts, ...
    'VariableNames', {'Condition','TotalTrials','BadTrials','GoodTrials'});

disp(condition_table)
```

