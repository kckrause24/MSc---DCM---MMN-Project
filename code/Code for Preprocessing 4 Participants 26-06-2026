## 2. Fixed pre-QC pipeline and visual QC opener

Edit only `subj` for each participant.

```matlab
%% Step 0 + Step 1
% Generate fixed pre-QC file if absent, then open for manual visual bad-channel review.

clear; clc;

%% Setup
restoredefaultpath
addpath(genpath('/Users/klauskrause/Documents/MATLAB/spm'))
spm('defaults','eeg')
spm_jobman('initcfg')

subj = 'sub-XXXXA';
runname = 'run-01';

dataset_root = '/Users/klauskrause/Desktop/ds004837';
workdir = '/Users/klauskrause/Documents/MATLAB/ds004837_controls_spm';

rawfile = fullfile(dataset_root, subj, 'ses-0001', 'meg', ...
    [subj '_ses-0001_task-attnmod_' runname '_meg.fif']);

cd(workdir);

continuous_name = ['spmeeg_' subj '_ses-0001_task-attnmod_' runname '_meg'];
trialfile = fullfile(workdir, ['trialdef_' subj '_' runname '.mat']);
epoch_name = ['e_' subj '_' runname];

preqc_file = fullfile(workdir, ['flp_fhp_dbe_' subj '_' runname '.mat']);

%% Check whether pre-QC file exists
if exist(preqc_file, 'file')
    disp('Fixed pre-QC file already exists. Skipping fixed preprocessing.')
    disp(['Existing pre-QC file: ' preqc_file])

else
    disp('Fixed pre-QC file does not exist. Running fixed preprocessing pipeline now.')

    if ~exist(rawfile, 'file')
        error(['Raw FIF file not found: ' rawfile])
    end

    %% 1. Convert raw FIF -> continuous SPM
    S = [];
    S.dataset = rawfile;
    S.outfile = continuous_name;
    S.channels = 'MEG';
    S.mode = 'continuous';

    D_cont = spm_eeg_convert(S);

    %% 2. Define trials from STI101_up
    D = spm_eeg_load(fullfile(workdir, [continuous_name '.mat']));
    ev = events(D);

    sel = strcmp({ev.type}, 'STI101_up');

    vals_raw = {ev(sel).value};
    vals = zeros(numel(vals_raw),1);

    for k = 1:numel(vals_raw)
        vals(k) = double(vals_raw{k});
    end

    times = [ev(sel).time]';

    trl = [];
    conditionlabels = {};

    for k = 1:numel(vals)
        if ismember(vals(k), [1 2 3])
            onset_sample = round(times(k) * D.fsample);
            start_sample = onset_sample + round((-100/1000) * D.fsample);
            end_sample   = onset_sample + round((300/1000) * D.fsample);
            offset = round((-100/1000) * D.fsample);

            trl(end+1, :) = [start_sample end_sample offset]; %#ok<SAGROW>

            if vals(k) == 1
                conditionlabels{end+1,1} = 'Standard'; %#ok<SAGROW>
            elseif vals(k) == 2
                conditionlabels{end+1,1} = 'Pitch Deviant'; %#ok<SAGROW>
            elseif vals(k) == 3
                conditionlabels{end+1,1} = 'Duration Deviant'; %#ok<SAGROW>
            end
        end
    end

    save(trialfile, 'trl', 'conditionlabels');

    disp('Checking trial definition file...')
    disp(size(trl))
    disp(conditionlabels(1:min(5,numel(conditionlabels))))

    %% 3. Convert continuous -> epoched
    S = [];
    S.dataset = fullfile(workdir, [continuous_name '.mat']);
    S.outfile = epoch_name;
    S.channels = 'MEG';
    S.mode = 'epoched';
    S.trl = trialfile;
    S.conditionlabels = conditionlabels;

    D_ep = spm_eeg_convert(S);

    %% 4. Baseline correction
    S = [];
    S.D = fullfile(workdir, [epoch_name '.mat']);
    S.timewin = [-100 0];
    S.prefix = 'b';

    D_bc = spm_eeg_bc(S);

    %% 5. Downsample
    S = [];
    S.D = fullfile(workdir, D_bc.fname);
    S.fsample_new = 200;
    S.prefix = 'd';

    D_ds = spm_eeg_downsample(S);

    %% 6. High-pass filter
    S = [];
    S.D = fullfile(workdir, D_ds.fname);
    S.band = 'high';
    S.freq = 0.5;
    S.type = 'butterworth';
    S.dir = 'twopass';
    S.prefix = 'fhp_';

    D_hp = spm_eeg_filter(S);

    %% 7. Low-pass filter
    S = [];
    S.D = fullfile(workdir, D_hp.fname);
    S.band = 'low';
    S.freq = 20;
    S.type = 'butterworth';
    S.dir = 'twopass';
    S.prefix = 'flp_';

    D_lp = spm_eeg_filter(S);

    disp('Pre-QC fixed pipeline complete.')
    disp(['Final pre-QC file: ' fullfile(workdir, D_lp.fname)])

    preqc_file = fullfile(workdir, D_lp.fname);
end

%% Step 1: Load filtered pre-QC file and begin visual bad-channel review
D = spm_eeg_load(preqc_file);

disp('Loaded pre-QC file:')
disp(preqc_file)
disp(D)

fprintf('\nParticipant: %s\n', subj)
fprintf('Number of trials: %d\n', D.ntrials)
fprintf('Sampling rate: %.1f Hz\n', D.fsample)
fprintf('Time window: %.1f to %.1f ms\n', D.time(1)*1000, D.time(end)*1000)
fprintf('Number of channels: %d\n', D.nchannels)

%% Condition counts
conds = string(conditions(D))';
u = unique(conds);

counts = zeros(numel(u),1);
for i = 1:numel(u)
    counts(i) = sum(conds == u(i));
end

disp('Condition counts:')
disp(table(u, counts, 'VariableNames', {'Condition','Count'}))

%% Existing bad channels
bad_idx = badchannels(D);

disp('Existing bad channels before review:')
if isempty(bad_idx)
    disp('None')
else
    disp(chanlabels(D, bad_idx)')
end

%% Suggested trial samples for visual inspection
standard_idx = find(conds == "Standard");
pitch_idx    = find(conds == "Pitch Deviant");
duration_idx = find(conds == "Duration Deviant");

sample_standard = standard_idx(round(linspace(1, numel(standard_idx), min(7,numel(standard_idx)))));
sample_pitch    = pitch_idx(round(linspace(1, numel(pitch_idx), min(4,numel(pitch_idx)))));
sample_duration = duration_idx(round(linspace(1, numel(duration_idx), min(4,numel(duration_idx)))));

disp('Suggested Standard trials to inspect:')
disp(sample_standard')

disp('Suggested Pitch Deviant trials to inspect:')
disp(sample_pitch')

disp('Suggested Duration Deviant trials to inspect:')
disp(sample_duration')

%% Open review
spm_eeg_review(D);

disp('Now visually inspect sampled trials across all three conditions.')
disp('Decision rule: mark a channel bad if it is abnormal in about 50% of inspected trials and appears across more than one condition type.')
```

