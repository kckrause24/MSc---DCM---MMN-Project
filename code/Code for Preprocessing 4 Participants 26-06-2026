## 7. Ranked-channel QC

Edit the `watch_list` where useful.

```matlab
%% Extra QC
% Rank largest remaining good channels in averaged conditions

clear; clc;

restoredefaultpath
addpath(genpath('/Users/klauskrause/Documents/MATLAB/spm'))
spm('defaults','eeg')
spm_jobman('initcfg')

workdir = '/Users/klauskrause/Documents/MATLAB/ds004837_controls_spm';
cd(workdir);

subj = 'sub-XXXXA';
runname = 'run-01';

avg_file = fullfile(workdir, ['maflp_fhp_dbe_' subj '_' runname '.mat']);

D_avg = spm_eeg_load(avg_file);

labels = chanlabels(D_avg);
bad_idx = badchannels(D_avg);
good_idx = setdiff(1:D_avg.nchannels, bad_idx);

watch_list = {'MEGxxxx'};

fprintf('\nAveraged file: %s\n', avg_file)

disp('Current bad channels:')
disp(chanlabels(D_avg, bad_idx)')

disp('Averaged condition order:')
for tr = 1:D_avg.ntrials
    fprintf('Trial %d = %s\n', tr, char(conditions(D_avg, tr)));
end

for tr = 1:D_avg.ntrials
    cond_name = char(conditions(D_avg, tr));

    dat = D_avg(good_idx,:,tr);
    mx = max(abs(dat), [], 2);

    [sorted_mx, order] = sort(mx, 'descend');
    top_idx = good_idx(order(1:min(20,numel(order))));
    top_labels = labels(top_idx)';

    fprintf('\nCondition %d: %s\n', tr, cond_name)
    disp(table(top_labels, sorted_mx(1:numel(top_labels)), ...
        'VariableNames', {'Channel','MaxAbsAmplitude'}))

    overlap = intersect(top_labels, watch_list);
    if ~isempty(overlap)
        disp('Watch-list channels appearing among largest channels:')
        disp(overlap')
    else
        disp('No watch-list channels among largest channels.')
    end
end
