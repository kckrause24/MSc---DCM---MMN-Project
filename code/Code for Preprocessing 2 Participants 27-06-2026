## sub-2246A - save initial bad channels and calibrate threshold

```matlab
subj = 'sub-2246A';
preqc_file = fullfile(workdir, ['flp_fhp_dbe_' subj '_' runname '.mat']);

D = spm_eeg_load(preqc_file);

initial_bad_labels = {'MEG0731','MEG1121','MEG2241','MEG2531'};
labels = chanlabels(D);
idx_bad = find(ismember(labels, initial_bad_labels));

if numel(idx_bad) ~= numel(initial_bad_labels)
    error('Not all requested bad-channel labels were found.');
end

D = badchannels(D, ':', 0);
D = badchannels(D, idx_bad, 1);
save(D);

D = spm_eeg_load(preqc_file);
goodch = setdiff(1:D.nchannels, badchannels(D));
mx_trial = zeros(D.ntrials,1);

for tr = 1:D.ntrials
    dat = D(goodch,:,tr);
    mx_trial(tr) = max(abs(dat(:)));
end

disp(prctile(mx_trial,[90 95 97.5 99 99.5]))
```

Selected threshold for `sub-2246A`: `9431`.

## sub-2246A - artefact rejection and condition counts

```matlab
subj = 'sub-2246A';
preqc_file = fullfile(workdir, ['flp_fhp_dbe_' subj '_' runname '.mat']);
art_file   = fullfile(workdir, ['aflp_fhp_dbe_' subj '_' runname '.mat']);
threshold = 9431;

S = [];
S.D = preqc_file;
S.mode = 'reject';
S.badchanthresh = 0.2;
S.append = true;
S.methods(1).channels = {'MEG'};
S.methods(1).fun = 'threshchan';
S.methods(1).settings.threshold = threshold;
S.methods(1).settings.excwin = 400;
S.prefix = 'a';

D_art = spm_eeg_artefact(S);

D_art = spm_eeg_load(art_file);
bt = badtrials(D_art);
if isnumeric(bt) && ~islogical(bt)
    tmp = false(D_art.ntrials,1);
    tmp(bt) = true;
    bt = tmp;
else
    bt = bt(:);
end

fprintf('Total trials: %d\n', D_art.ntrials)
fprintf('Bad trials: %d\n', sum(bt))
fprintf('Good trials: %d\n', sum(~bt))
fprintf('Percent rejected: %.2f%%\n', 100 * sum(bt) / D_art.ntrials)

conds = string(conditions(D_art))';
u = unique(conds);
for i = 1:numel(u)
    sel = conds == u(i);
    fprintf('%s: total=%d bad=%d good=%d\n', u(i), sum(sel), sum(bt(sel)), sum(sel & ~bt));
end
```

## Robust averaging function

```matlab
function D_avg = run_robust_average(art_file)
    S = [];
    S.D = art_file;
    S.robust = [];
    S.robust.ks = 3;
    S.robust.bycondition = 1;
    S.robust.savew = 1;
    S.removebad = 1;
    S.plv = 0;
    S.updatehistory = 1;
    S.prefix = 'm';
    D_avg = spm_eeg_average(S);
end
```

## Ranked-channel QC function

```matlab
function ranked_channel_qc(avg_file, watch_list)
    D_avg = spm_eeg_load(avg_file);
    labels = chanlabels(D_avg);
    bad_idx = badchannels(D_avg);
    good_idx = setdiff(1:D_avg.nchannels, bad_idx);

    disp('Current bad channels:')
    disp(chanlabels(D_avg, bad_idx)')

    disp('Averaged condition order:')
    for tr = 1:D_avg.ntrials
        fprintf('Trial %d = %s\n', tr, char(conditions(D_avg, tr)));
    end

    for tr = 1:D_avg.ntrials
        cond_name = char(conditions(D_avg, tr));
        dat = D_avg(good_idx,:,tr);
        mx = max(abs(dat), [], 2);
        [sorted_mx, order] = sort(mx, 'descend');
        top_idx = good_idx(order(1:min(20,numel(order))));
        top_labels = labels(top_idx)';

        fprintf('\nCondition %d: %s\n', tr, cond_name)
        disp(table(top_labels, sorted_mx(1:numel(top_labels)), ...
            'VariableNames', {'Channel','MaxAbsAmplitude'}))

        overlap = intersect(top_labels, watch_list);
        if ~isempty(overlap)
            disp('Watch-list channels appearing among largest channels:')
            disp(overlap')
        else
            disp('No watch-list channels among largest channels.')
        end
    end
end
```

