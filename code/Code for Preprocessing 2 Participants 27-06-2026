idx_final = find(ismember(labels, final_bad_labels));

if numel(idx_final) ~= numel(final_bad_labels)
    error('Not all final bad-channel labels were found.');
end

D_art = badchannels(D_art, ':', 0);
D_art = badchannels(D_art, idx_final, 1);
save(D_art);

if exist(avg_file, 'file')
    delete(avg_file);
end
avg_dat = strrep(avg_file, '.mat', '.dat');
if exist(avg_dat, 'file')
    delete(avg_dat);
end

D_avg = run_robust_average(art_file);
spm_eeg_review(D_avg);
```

