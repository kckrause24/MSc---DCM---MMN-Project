## 2. Save initial bad channels and calibrate threshold

Use index-based marking. Do not pass a cell array of labels directly to `badchannels`.

```matlab
%% Save initial bad channels and calibrate artefact threshold

clear; clc;

restoredefaultpath
addpath(genpath('/Users/klauskrause/Documents/MATLAB/spm'))
spm('defaults','eeg')
spm_jobman('initcfg')

workdir = '/Users/klauskrause/Documents/MATLAB/ds004837_controls_spm';
cd(workdir);

subj = 'sub-2342A';
runname = 'run-01';
preqc_file = fullfile(workdir, ['flp_fhp_dbe_' subj '_' runname '.mat']);

D = spm_eeg_load(preqc_file);

% Edit for each participant.
initial_bad_labels = {'MEG1911','MEG2231'};

labels = chanlabels(D);
idx = find(ismember(labels, initial_bad_labels));

disp('Requested initial bad channels:')
disp(initial_bad_labels')

disp('Matched initial bad channels:')
disp(table(idx(:), labels(idx)', ...
    'VariableNames', {'Index','ChannelLabel'}))

if numel(idx) ~= numel(initial_bad_labels)
    error('Not all initial bad-channel labels were found. Check labels before saving.');
end

D = badchannels(D, ':', 0);
D = badchannels(D, idx, 1);
save(D);

disp('Initial bad channels saved:')
disp(chanlabels(D, badchannels(D))')

%% Threshold calibration
D = spm_eeg_load(preqc_file);

goodch = setdiff(1:D.nchannels, badchannels(D));
mx_trial = zeros(D.ntrials,1);

for tr = 1:D.ntrials
    dat = D(goodch,:,tr);
    mx_trial(tr) = max(abs(dat(:)));
end

disp('Percentiles of maximum absolute trial amplitude:')
disp(prctile(mx_trial,[90 95 97.5 99 99.5]))

disp(['Maximum value across trials: ' num2str(max(mx_trial))])

candidate_thresholds = round(prctile(mx_trial,[95 97.5 99 99.5]));

fprintf('\nPercentile-based candidate thresholds for %s\n', subj)
fprintf('Total trials: %d\n\n', D.ntrials)

for i = 1:numel(candidate_thresholds)
    th = candidate_thresholds(i);
    n_bad = sum(mx_trial > th);
    pct_bad = 100 * n_bad / numel(mx_trial);
    fprintf('Trials exceeding %d: %d / %d (%.2f%%)\n', ...
        th, n_bad, numel(mx_trial), pct_bad);
end
