% Final DCM input file
% -------------------------------------------------------------------------

fprintf('\nFinal DCM-ready grand mean file:\n%s\n', ...
baseline_corrected_grandmean_file);

fprintf('\nUse this in DCM scripts as:\n');
fprintf('DCM.xY.Dfile = ''%s'';\n', baseline_corrected_grandmean_file);
