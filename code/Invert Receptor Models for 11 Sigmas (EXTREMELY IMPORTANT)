%% ========================================================================
% RECEPTOR-INFORMED DCM SIGMA SENSITIVITY ANALYSIS
%
% Fits receptor-informed five-source, ten-G CMC models using:
%
%   sigma = 0.5, 1, 2, 3, 4, 5, 6, 7, 8, 9 and 10 cm
%
% The 1-cm model is evaluated first as a reproducibility check.
% A small difference from the previously validated free energy is reported
% as a warning only. It does not stop the remaining inversions.
%
% For every sigma, the script:
%   1. Constructs a source-specific 5 x 10 receptor prior matrix.
%   2. Recreates the complete custom ten-G prior structure.
%   3. Replaces only DCM.M.pE.G.
%   4. Keeps all prior covariance fields unchanged.
%   5. Runs one deterministic prior-centred inversion.
%   6. Saves the uninverted and inverted model.
%   7. Extracts free energy and compares it with the matched baseline.
%
% No random EM starts are used.
%% ========================================================================

clear;
clc;
format long g;

%% ========================================================================
% INITIALISE MATLAB, SPM AND CUSTOM FUNCTIONS
% ========================================================================

restoredefaultpath;
rehash toolboxcache;

spm_directory = ...
    '/Users/klauskrause/Documents/MATLAB/spm';

working_functions_directory = ...
    ['/Users/klauskrause/Documents/MATLAB/' ...
     'ds004837_controls_spm/DCM_Day4_10G_Diagnostic/' ...
     'Ulrich_10G_working_functions'];

assert(isfolder(spm_directory), ...
    'SPM directory not found:\n%s', spm_directory);

assert(isfolder(working_functions_directory), ...
    'Custom-functions directory not found:\n%s', ...
    working_functions_directory);

% Add and initialise SPM.
addpath(spm_directory);

spm('defaults', 'EEG');
spm_jobman('initcfg');

% Put the custom functions before standard SPM functions where names overlap.
addpath(working_functions_directory, '-begin');

rehash toolboxcache;

assert(exist('spm_dcm_erp_data', 'file') == 2, ...
    'MATLAB cannot find spm_dcm_erp_data.');

assert(exist('mmn_spm_dcm_neural_priors', 'file') == 2, ...
    'MATLAB cannot find mmn_spm_dcm_neural_priors.');

assert(exist('mmn_spm_dcm_erp_MP_eP', 'file') == 2, ...
    'MATLAB cannot find mmn_spm_dcm_erp_MP_eP.');

fprintf('\n============================================================\n');
fprintf('FUNCTIONS IN USE\n');
fprintf('============================================================\n');

fprintf('SPM:\n%s\n\n', which('spm'));

fprintf('spm_dcm_erp_data:\n%s\n\n', ...
    which('spm_dcm_erp_data'));

fprintf('Custom inversion:\n%s\n\n', ...
    which('mmn_spm_dcm_erp_MP_eP'));

fprintf('Custom neural priors:\n%s\n', ...
    which('mmn_spm_dcm_neural_priors'));

%% ========================================================================
% FILES AND DIRECTORIES
% ========================================================================

project_directory = ...
    ['/Users/klauskrause/Documents/MATLAB/' ...
     'ds004837_controls_spm/DCM_Day5_5Source_Ulrich'];

template_dcm_file = fullfile( ...
    project_directory, ...
    'DCM_20HC_standard_pitch_CMC_5source_ULRICH_UNINVERTED.mat');

baseline_file = fullfile( ...
    project_directory, ...
    ['DCM_20HC_standard_pitch_CMC_5source_' ...
     'MATCHED_10G_BASELINE_INVERTED.mat']);

historical_dcm_file = ...
    ['/Users/klauskrause/Documents/MATLAB/' ...
     'Receptor_Prior_Calculation/' ...
     '_DCM_ALL_44reg_PCA.mat'];

coordinate_file = ...
    ['/Users/klauskrause/Documents/MATLAB/' ...
     'Receptor_Prior_Calculation/' ...
     'D_seeg_table_PCA_win4PC_1stLev.xls'];

output_directory = fullfile( ...
    project_directory, ...
    'Sigma_Sensitivity_Analysis');

prior_directory = fullfile( ...
    output_directory, ...
    'Receptor_Priors');

uninverted_directory = fullfile( ...
    output_directory, ...
    'Uninverted_Models');

inverted_directory = fullfile( ...
    output_directory, ...
    'Inverted_Models');

log_directory = fullfile( ...
    output_directory, ...
    'Logs');

directories = {
    output_directory
    prior_directory
    uninverted_directory
    inverted_directory
    log_directory
};

for directory_index = 1:numel(directories)

    if ~exist(directories{directory_index}, 'dir')
        mkdir(directories{directory_index});
    end
end

%% ========================================================================
% ANALYSIS SETTINGS
% ========================================================================

% Run 1 cm first as a reproducibility check.
sigma_run_order_cm = [1 0.5 2 3 4 5 6 7 8 9 10];

expected_sigma1_F = 12.220501478673;

% Used only to decide whether to print PASS or WARNING.
% The script continues in either case.
sigma1_tolerance = 1e-3;

% Reuse an existing model only if the saved file contains a finite DCM.F.
reuse_valid_existing_models = true;

%% ========================================================================
% VERIFY INPUT FILES
% ========================================================================

assert(isfile(template_dcm_file), ...
    'Template DCM not found:\n%s', template_dcm_file);

assert(isfile(baseline_file), ...
    'Matched baseline not found:\n%s', baseline_file);

assert(isfile(historical_dcm_file), ...
    'Historical DCM archive not found:\n%s', historical_dcm_file);

assert(isfile(coordinate_file), ...
    'Coordinate spreadsheet not found:\n%s', coordinate_file);

%% ========================================================================
% LOAD THE UNINVERTED FIVE-SOURCE TEMPLATE
% ========================================================================

template_data = load(template_dcm_file, 'DCM');

assert(isfield(template_data, 'DCM'), ...
    'Template file does not contain a variable named DCM.');

DCM_template = template_data.DCM;

assert(isfield(DCM_template, 'Lpos'), ...
    'Template DCM does not contain Lpos.');

assert(isfield(DCM_template, 'Sname'), ...
    'Template DCM does not contain Sname.');

source_xyz = double(DCM_template.Lpos');

n_sources = size(source_xyz, 1);

assert(n_sources == 5, ...
    'Expected five sources but found %d.', n_sources);

fprintf('\n============================================================\n');
fprintf('MODEL SOURCES\n');
fprintf('============================================================\n');

for source_index = 1:n_sources

    fprintf('%d. %-12s [%7.2f %7.2f %7.2f]\n', ...
        source_index, ...
        DCM_template.Sname{source_index}, ...
        source_xyz(source_index, 1), ...
        source_xyz(source_index, 2), ...
        source_xyz(source_index, 3));
end

%% ========================================================================
% CREATE THE REFERENCE TEN-G PRIOR STRUCTURE
% ========================================================================

[reference_pE, reference_pC] = ...
    mmn_spm_dcm_neural_priors( ...
        DCM_template.A, ...
        DCM_template.B, ...
        DCM_template.C, ...
        DCM_template.options.model);

assert(isfield(reference_pE, 'G'), ...
    'Custom prior function did not return pE.G.');

assert(isfield(reference_pC, 'G'), ...
    'Custom prior function did not return pC.G.');

assert(isequal(size(reference_pE.G), [5 10]), ...
    'Expected reference pE.G to be 5 x 10.');

assert(isequal(size(reference_pC.G), [5 10]), ...
    'Expected reference pC.G to be 5 x 10.');

assert(nnz(reference_pE.G) == 0, ...
    'Reference pE.G is not zero-centred.');

fprintf('\n============================================================\n');
fprintf('REFERENCE PRIORS\n');
fprintf('============================================================\n');

fprintf('size(pE.G): %d x %d\n', ...
    size(reference_pE.G, 1), ...
    size(reference_pE.G, 2));

fprintf('size(pC.G): %d x %d\n', ...
    size(reference_pC.G, 1), ...
    size(reference_pC.G, 2));

fprintf('Number of non-zero baseline pE.G entries: %d\n', ...
    nnz(reference_pE.G));

fprintf('Unique pC.G values:\n');
disp(unique(full(reference_pC.G(:)))');

%% ========================================================================
% LOAD HISTORICAL iEEG DCM ESTIMATES
% ========================================================================

historical_data = load(historical_dcm_file);

assert(isfield(historical_data, 'DCM_ALL'), ...
    'Historical file does not contain DCM_ALL.');

DCM_ALL = historical_data.DCM_ALL;

n_contacts = numel(DCM_ALL);

contact_G = nan(n_contacts, 10);

for contact_index = 1:n_contacts

    if iscell(DCM_ALL)
        current_dcm = DCM_ALL{contact_index};
    else
        current_dcm = DCM_ALL(contact_index);
    end

    assert(isfield(current_dcm, 'Ep'), ...
        'Historical DCM %d does not contain Ep.', contact_index);

    assert(isfield(current_dcm.Ep, 'G'), ...
        'Historical DCM %d does not contain Ep.G.', contact_index);

    current_G = full(double(current_dcm.Ep.G));

    assert(numel(current_G) == 10, ...
        ['Historical DCM %d contains %d G parameters; ' ...
         'ten were expected.'], ...
        contact_index, ...
        numel(current_G));

    contact_G(contact_index, :) = ...
        reshape(current_G, 1, 10);
end

assert(all(isfinite(contact_G(:))), ...
    'Historical G matrix contains non-finite values.');

fprintf('\n============================================================\n');
fprintf('HISTORICAL iEEG PARAMETERS\n');
fprintf('============================================================\n');

fprintf('Number of DCMs: %d\n', n_contacts);
fprintf('Size of G matrix: %d x %d\n', size(contact_G));

%% ========================================================================
% LOAD iEEG MNI COORDINATES
% ========================================================================

coordinate_table = readtable( ...
    coordinate_file, ...
    'VariableNamingRule', ...
    'preserve');

variable_names = coordinate_table.Properties.VariableNames;

x_index = find(strcmpi(variable_names, 'x_original'), 1);
y_index = find(strcmpi(variable_names, 'y_original'), 1);
z_index = find(strcmpi(variable_names, 'z_original'), 1);

assert(~isempty(x_index), ...
    'Could not find x_original in the coordinate spreadsheet.');

assert(~isempty(y_index), ...
    'Could not find y_original in the coordinate spreadsheet.');

assert(~isempty(z_index), ...
    'Could not find z_original in the coordinate spreadsheet.');

contact_xyz = [
    double(coordinate_table{:, x_index}), ...
    double(coordinate_table{:, y_index}), ...
    double(coordinate_table{:, z_index})
];

assert(size(contact_xyz, 1) == n_contacts, ...
    ['Coordinate rows (%d) do not match the number of historical ' ...
     'DCMs (%d).'], ...
    size(contact_xyz, 1), ...
    n_contacts);

assert(size(contact_xyz, 2) == 3, ...
    'Coordinate matrix must be N x 3.');

assert(all(isfinite(contact_xyz(:))), ...
    'Coordinate matrix contains non-finite values.');

fprintf('\n============================================================\n');
fprintf('COORDINATE MATRIX\n');
fprintf('============================================================\n');

fprintf('Size: %d x %d\n', size(contact_xyz));

%% ========================================================================
% LOAD AND VERIFY THE MATCHED BASELINE
% ========================================================================

baseline_data = load(baseline_file, 'DCM');

assert(isfield(baseline_data, 'DCM'), ...
    'Baseline file does not contain a variable named DCM.');

DCM_baseline = baseline_data.DCM;

assert(isfield(DCM_baseline, 'F'), ...
    'Baseline model does not contain free energy.');

assert(isfinite(DCM_baseline.F), ...
    'Baseline free energy is not finite.');

F_baseline = double(DCM_baseline.F);

assert(isfield(DCM_baseline, 'M') && ...
       isfield(DCM_baseline.M, 'pE') && ...
       isfield(DCM_baseline.M, 'pC'), ...
    'Baseline model does not contain complete prior structures.');

baseline_pE_G = full(double(DCM_baseline.M.pE.G));
baseline_pC_G = full(double(DCM_baseline.M.pC.G));

assert(isequal(size(baseline_pE_G), [5 10]), ...
    'Baseline pE.G is not 5 x 10.');

assert(isequal(size(baseline_pC_G), [5 10]), ...
    'Baseline pC.G is not 5 x 10.');

max_baseline_pC_difference = max(abs( ...
    baseline_pC_G(:) - ...
    full(double(reference_pC.G(:)))));

assert(max_baseline_pC_difference < 1e-12, ...
    'Baseline pC.G does not match the reference pC.G.');

fprintf('\n============================================================\n');
fprintf('MATCHED BASELINE\n');
fprintf('============================================================\n');

fprintf('Free energy: %.12f\n', F_baseline);

fprintf('Maximum baseline-reference pC.G difference: %.16g\n', ...
    max_baseline_pC_difference);

%% ========================================================================
% PREALLOCATE RESULTS
% ========================================================================

n_sigma = numel(sigma_run_order_cm);

result_sigma_cm = nan(n_sigma, 1);
result_sigma_mm = nan(n_sigma, 1);
result_F = nan(n_sigma, 1);
result_deltaF_baseline = nan(n_sigma, 1);
result_runtime_minutes = nan(n_sigma, 1);
result_maximum_G_change = nan(n_sigma, 1);
result_mean_G_change = nan(n_sigma, 1);
result_status = cell(n_sigma, 1);
result_model_file = cell(n_sigma, 1);

%% ========================================================================
% RUN SIGMA MODELS
% ========================================================================

for sigma_index = 1:n_sigma

    sigma_cm = sigma_run_order_cm(sigma_index);
    sigma_mm = sigma_cm * 10;

    sigma_label = strrep( ...
        sprintf('%g', sigma_cm), ...
        '.', ...
        'p');

    prior_file = fullfile( ...
        prior_directory, ...
        sprintf( ...
            'MMN_5source_G_priors_sigma_%scm.mat', ...
            sigma_label));

    uninverted_file = fullfile( ...
        uninverted_directory, ...
        sprintf( ...
            ['DCM_20HC_standard_pitch_CMC_5source_' ...
             'RECEPTOR_SIGMA_%scm_UNINVERTED.mat'], ...
            sigma_label));

    inverted_file = fullfile( ...
        inverted_directory, ...
        sprintf( ...
            ['DCM_20HC_standard_pitch_CMC_5source_' ...
             'RECEPTOR_SIGMA_%scm_INVERTED.mat'], ...
            sigma_label));

    diary_file = fullfile( ...
        log_directory, ...
        sprintf( ...
            'sigma_%scm_inversion_diary.txt', ...
            sigma_label));

    result_sigma_cm(sigma_index) = sigma_cm;
    result_sigma_mm(sigma_index) = sigma_mm;
    result_model_file{sigma_index} = inverted_file;

    fprintf('\n\n');
    fprintf('============================================================\n');
    fprintf('SIGMA = %g CM (%g MM)\n', sigma_cm, sigma_mm);
    fprintf('MODEL %d OF %d\n', sigma_index, n_sigma);
    fprintf('============================================================\n');

    %% --------------------------------------------------------------------
    % REUSE A VALID EXISTING INVERSION
    % ---------------------------------------------------------------------

    use_existing_model = false;

    if reuse_valid_existing_models && isfile(inverted_file)

        try

            existing_data = load(inverted_file, 'DCM');

            if isfield(existing_data, 'DCM') && ...
                    isfield(existing_data.DCM, 'F') && ...
                    isfinite(existing_data.DCM.F)

                use_existing_model = true;
                DCM = existing_data.DCM;
            end

        catch
            use_existing_model = false;
        end
    end

    if use_existing_model

        fprintf('Valid existing inverted model found.\n');
        fprintf('Loading rather than rerunning this sigma.\n');

        result_F(sigma_index) = double(DCM.F);

        result_deltaF_baseline(sigma_index) = ...
            result_F(sigma_index) - F_baseline;

        if isfield(DCM, 'Ep') && ...
                isfield(DCM.Ep, 'G') && ...
                isfield(DCM.M, 'pE') && ...
                isfield(DCM.M.pE, 'G')

            G_change = ...
                full(double(DCM.Ep.G)) - ...
                full(double(DCM.M.pE.G));

            result_maximum_G_change(sigma_index) = ...
                max(abs(G_change(:)));

            result_mean_G_change(sigma_index) = ...
                mean(abs(G_change(:)));
        end

        result_status{sigma_index} = ...
            'Loaded valid existing model';

    else

        %% ----------------------------------------------------------------
        % CONSTRUCT RECEPTOR-INFORMED PRIOR MATRIX
        % -----------------------------------------------------------------

        receptor_pE_G = zeros(n_sources, 10);
        nearest_distance_mm = zeros(n_sources, 1);
        effective_contributors = zeros(n_sources, 1);

        for source_index = 1:n_sources

            coordinate_difference = ...
                contact_xyz - source_xyz(source_index, :);

            distances_mm = sqrt( ...
                sum(coordinate_difference .^ 2, 2));

            weights = exp( ...
                -(distances_mm .^ 2) ./ ...
                (2 * sigma_mm ^ 2));

            assert(all(isfinite(weights)), ...
                ['Non-finite Gaussian weights generated for ' ...
                 'sigma %g cm, source %d.'], ...
                sigma_cm, ...
                source_index);

            weight_sum = sum(weights);

            assert(weight_sum > 0, ...
                ['All Gaussian weights were zero for sigma %g cm, ' ...
                 'source %d.'], ...
                sigma_cm, ...
                source_index);

            weights = weights ./ weight_sum;

            assert(abs(sum(weights) - 1) < 1e-12, ...
                'Normalised Gaussian weights do not sum to one.');

            receptor_pE_G(source_index, :) = ...
                weights' * contact_G;

            nearest_distance_mm(source_index) = ...
                min(distances_mm);

            effective_contributors(source_index) = ...
                1 / sum(weights .^ 2);
        end

        assert(isequal(size(receptor_pE_G), [5 10]), ...
            'Receptor pE.G matrix is not 5 x 10.');

        assert(all(isfinite(receptor_pE_G(:))), ...
            'Receptor pE.G contains non-finite values.');

        fprintf('\nRECEPTOR PRIOR MATRIX\n');
        disp(receptor_pE_G);

        fprintf('Nearest-contact distances, mm:\n');
        disp(nearest_distance_mm');

        fprintf('Effective contributing-contact counts:\n');
        disp(effective_contributors');

        save( ...
            prior_file, ...
            'receptor_pE_G', ...
            'sigma_cm', ...
            'sigma_mm', ...
            'source_xyz', ...
            'contact_xyz', ...
            'nearest_distance_mm', ...
            'effective_contributors', ...
            '-v7.3');

        %% ----------------------------------------------------------------
        % CONSTRUCT COMPLETE CORRECTED RECEPTOR-INFORMED MODEL
        % -----------------------------------------------------------------

        DCM = DCM_template;

        [pE, pC] = mmn_spm_dcm_neural_priors( ...
            DCM.A, ...
            DCM.B, ...
            DCM.C, ...
            DCM.options.model);

        assert(isequal(size(pE.G), [5 10]), ...
            'Generated pE.G is not 5 x 10.');

        assert(isequal(size(pC.G), [5 10]), ...
            'Generated pC.G is not 5 x 10.');

        % Preserve the complete prior structures generated by the custom
        % ten-G function.
        DCM.M.pE = pE;
        DCM.M.pC = pC;

        % Replace only the intrinsic G prior expectations.
        DCM.M.pE.G = sparse(receptor_pE_G);

        %% ----------------------------------------------------------------
        % PRE-INVERSION AUDIT
        % -----------------------------------------------------------------

        assert(isequaln(DCM.A, DCM_template.A), ...
            'A matrices changed during model preparation.');

        assert(isequaln(DCM.B, DCM_template.B), ...
            'B matrices changed during model preparation.');

        assert(isequaln(DCM.C, DCM_template.C), ...
            'C matrix changed during model preparation.');

        assert(isequaln(DCM.Lpos, DCM_template.Lpos), ...
            'Source locations changed during model preparation.');

        assert(isequaln(DCM.Sname, DCM_template.Sname), ...
            'Source names changed during model preparation.');

        assert(isequaln(DCM.xU, DCM_template.xU), ...
            'Experimental inputs changed during model preparation.');

        assert(isequaln(DCM.options, DCM_template.options), ...
            'DCM options changed during model preparation.');

        prepared_pE_G = full(double(DCM.M.pE.G));
        prepared_pC_G = full(double(DCM.M.pC.G));

        max_pE_difference_from_baseline = max(abs( ...
            prepared_pE_G(:) - ...
            baseline_pE_G(:)));

        max_pC_difference_from_baseline = max(abs( ...
            prepared_pC_G(:) - ...
            baseline_pC_G(:)));

        assert(max_pE_difference_from_baseline > 0, ...
            'Receptor pE.G does not differ from baseline pE.G.');

        assert(max_pC_difference_from_baseline < 1e-12, ...
            'Receptor pC.G differs from baseline pC.G.');

        fprintf('\nPRE-INVERSION AUDIT\n');

        fprintf('pE.G size: %d x %d\n', ...
            size(DCM.M.pE.G, 1), ...
            size(DCM.M.pE.G, 2));

        fprintf('pC.G size: %d x %d\n', ...
            size(DCM.M.pC.G, 1), ...
            size(DCM.M.pC.G, 2));

        fprintf('Maximum pE.G difference from baseline: %.12f\n', ...
            max_pE_difference_from_baseline);

        fprintf('Maximum pC.G difference from baseline: %.16g\n', ...
            max_pC_difference_from_baseline);

        save(uninverted_file, 'DCM', '-v7.3');

        % Reload the saved structure before inversion.
        prepared_data = load(uninverted_file, 'DCM');
        DCM = prepared_data.DCM;

        saved_pE_G = full(double(DCM.M.pE.G));

        assert(max(abs( ...
            saved_pE_G(:) - receptor_pE_G(:))) < 1e-12, ...
            'Saved pE.G differs from the generated receptor matrix.');

        %% ----------------------------------------------------------------
        % RUN INVERSION
        % -----------------------------------------------------------------

        if isfile(diary_file)
            delete(diary_file);
        end

        diary(diary_file);

        fprintf('\nINVERSION STARTED\n');
        fprintf('Date and time: %s\n', datestr(now, 31));
        fprintf('Sigma: %g cm\n', sigma_cm);

        inversion_timer = tic;

        try

            DCM = mmn_spm_dcm_erp_MP_eP(DCM);

        catch inversion_error

            runtime_minutes = toc(inversion_timer) / 60;

            fprintf('\nINVERSION FAILED\n');
            fprintf('Runtime: %.2f minutes\n', runtime_minutes);
            fprintf('%s\n', getReport(inversion_error, 'extended'));

            diary off;

            result_runtime_minutes(sigma_index) = ...
                runtime_minutes;

            result_status{sigma_index} = ...
                ['FAILED: ' inversion_error.message];

            save_running_checkpoint( ...
                output_directory, ...
                result_sigma_cm, ...
                result_sigma_mm, ...
                result_F, ...
                result_deltaF_baseline, ...
                result_runtime_minutes, ...
                result_maximum_G_change, ...
                result_mean_G_change, ...
                result_status, ...
                result_model_file);

            error( ...
                ['Sigma %g cm inversion failed. ' ...
                 'No remaining models were run.\n\n%s'], ...
                sigma_cm, ...
                inversion_error.message);
        end

        runtime_minutes = toc(inversion_timer) / 60;

        fprintf('\nINVERSION FINISHED\n');
        fprintf('Date and time: %s\n', datestr(now, 31));
        fprintf('Runtime: %.2f minutes\n', runtime_minutes);

        diary off;

        %% ----------------------------------------------------------------
        % VALIDATE AND SAVE INVERSION
        % -----------------------------------------------------------------

        assert(isfield(DCM, 'F'), ...
            'Inverted model does not contain DCM.F.');

        assert(isfinite(DCM.F), ...
            'Inverted model free energy is not finite.');

        assert(isfield(DCM, 'Ep') && ...
               isfield(DCM.Ep, 'G'), ...
            'Inverted model does not contain DCM.Ep.G.');

        assert(isequal(size(DCM.Ep.G), [5 10]), ...
            'Posterior Ep.G is not 5 x 10.');

        save(inverted_file, 'DCM', '-v7.3');

        result_runtime_minutes(sigma_index) = ...
            runtime_minutes;

        result_F(sigma_index) = ...
            double(DCM.F);

        result_deltaF_baseline(sigma_index) = ...
            result_F(sigma_index) - F_baseline;

        G_change = ...
            full(double(DCM.Ep.G)) - ...
            full(double(DCM.M.pE.G));

        result_maximum_G_change(sigma_index) = ...
            max(abs(G_change(:)));

        result_mean_G_change(sigma_index) = ...
            mean(abs(G_change(:)));

        result_status{sigma_index} = 'Completed';

        fprintf('\nSIGMA %g CM RESULTS\n', sigma_cm);

        fprintf('Free energy: %.12f\n', ...
            result_F(sigma_index));

        fprintf('Delta F versus baseline: %+.12f\n', ...
            result_deltaF_baseline(sigma_index));

        fprintf('Maximum |posterior - prior| in G: %.12f\n', ...
            result_maximum_G_change(sigma_index));

        fprintf('Mean |posterior - prior| in G: %.12f\n', ...
            result_mean_G_change(sigma_index));
    end

    %% --------------------------------------------------------------------
    % SAVE CHECKPOINT AFTER EACH MODEL
    % ---------------------------------------------------------------------

    save_running_checkpoint( ...
        output_directory, ...
        result_sigma_cm, ...
        result_sigma_mm, ...
        result_F, ...
        result_deltaF_baseline, ...
        result_runtime_minutes, ...
        result_maximum_G_change, ...
        result_mean_G_change, ...
        result_status, ...
        result_model_file);

    %% --------------------------------------------------------------------
    % SIGMA = 1 CM REPRODUCIBILITY CHECK
    %
    % This check never stops the remaining inversions.
    % ---------------------------------------------------------------------

    if sigma_cm == 1

        sigma1_difference = abs( ...
            result_F(sigma_index) - expected_sigma1_F);

        fprintf('\n============================================================\n');
        fprintf('SIGMA 1 CM REPRODUCIBILITY CHECK\n');
        fprintf('============================================================\n');

        fprintf('Previous F: %.12f\n', expected_sigma1_F);

        fprintf('Current F:  %.12f\n', ...
            result_F(sigma_index));

        fprintf('Absolute difference: %.12g\n', ...
            sigma1_difference);

        if sigma1_difference <= sigma1_tolerance

            fprintf(['PASS: the 1-cm result reproduced within the ' ...
                     'specified tolerance.\n']);

        else

            warning( ...
                ['The 1-cm free energy differed slightly from the ' ...
                 'previous run.\n' ...
                 'Previous F: %.12f\n' ...
                 'Current F: %.12f\n' ...
                 'Absolute difference: %.12g\n' ...
                 'The remaining sigma models will continue running.'], ...
                expected_sigma1_F, ...
                result_F(sigma_index), ...
                sigma1_difference);
        end

        fprintf('Proceeding to the remaining sigma models.\n');
    end
end

%% ========================================================================
% CREATE FINAL RESULTS TABLES
% ========================================================================

sigma_results = table( ...
    result_sigma_cm, ...
    result_sigma_mm, ...
    result_F, ...
    result_deltaF_baseline, ...
    result_runtime_minutes, ...
    result_maximum_G_change, ...
    result_mean_G_change, ...
    result_status, ...
    result_model_file, ...
    'VariableNames', { ...
        'SigmaCm', ...
        'SigmaMm', ...
        'FreeEnergy', ...
        'DeltaFvsBaseline', ...
        'RuntimeMinutes', ...
        'MaximumAbsoluteGChange', ...
        'MeanAbsoluteGChange', ...
        'Status', ...
        'ModelFile'});

sigma_results = sortrows( ...
    sigma_results, ...
    'SigmaCm');

baseline_row = table( ...
    NaN, ...
    NaN, ...
    F_baseline, ...
    0, ...
    NaN, ...
    NaN, ...
    NaN, ...
    {'Matched baseline CMC'}, ...
    {baseline_file}, ...
    'VariableNames', ...
    sigma_results.Properties.VariableNames);

all_model_results = [
    sigma_results
    baseline_row
];

valid_free_energy = ...
    isfinite(all_model_results.FreeEnergy);

worst_free_energy = min( ...
    all_model_results.FreeEnergy(valid_free_energy));

all_model_results.DeltaFvsWorst = ...
    all_model_results.FreeEnergy - worst_free_energy;

model_labels = cell( ...
    height(all_model_results), ...
    1);

for row_index = 1:height(all_model_results)

    if isfinite(all_model_results.SigmaCm(row_index))

        model_labels{row_index} = sprintf( ...
            '\\sigma=%g', ...
            all_model_results.SigmaCm(row_index));

    else

        model_labels{row_index} = 'CMC';
    end
end

all_model_results.ModelLabel = model_labels;

writetable( ...
    sigma_results, ...
    fullfile( ...
        output_directory, ...
        'receptor_sigma_results.csv'));

writetable( ...
    all_model_results, ...
    fullfile( ...
        output_directory, ...
        'all_model_evidence_results.csv'));

save( ...
    fullfile( ...
        output_directory, ...
        'all_model_evidence_results.mat'), ...
    'sigma_results', ...
    'all_model_results', ...
    'F_baseline', ...
    'worst_free_energy');

fprintf('\n\n');
fprintf('============================================================\n');
fprintf('FINAL MODEL-EVIDENCE TABLE\n');
fprintf('============================================================\n');

disp(all_model_results(:, { ...
    'ModelLabel', ...
    'SigmaCm', ...
    'FreeEnergy', ...
    'DeltaFvsBaseline', ...
    'DeltaFvsWorst', ...
    'RuntimeMinutes', ...
    'Status'}));

%% ========================================================================
% CREATE MODEL-EVIDENCE FIGURE
% ========================================================================

figure_handle = figure( ...
    'Name', ...
    'MMN receptor-informed sigma comparison', ...
    'Color', ...
    'white');

bar(all_model_results.DeltaFvsWorst);

ax = gca;

ax.XTick = 1:height(all_model_results);
ax.XTickLabel = all_model_results.ModelLabel;
ax.XTickLabelRotation = 90;

xlabel('Model');
ylabel('\Delta free energy relative to worst model');
title('MMN receptor-informed model comparison');

box off;

exportgraphics( ...
    figure_handle, ...
    fullfile( ...
        output_directory, ...
        'MMN_model_comparison_all_sigmas.png'), ...
    'Resolution', ...
    300);

exportgraphics( ...
    figure_handle, ...
    fullfile( ...
        output_directory, ...
        'MMN_model_comparison_all_sigmas.pdf'), ...
    'ContentType', ...
    'vector');

fprintf('\n============================================================\n');
fprintf('ANALYSIS COMPLETE\n');
fprintf('============================================================\n');

fprintf('Results saved to:\n%s\n', output_directory);

