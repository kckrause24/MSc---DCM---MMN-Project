## Step 2: Save initial bad channel and calibrate artefact threshold

```matlab
%% sub-2259A second-pass preprocessing: Step 2
% Save initial bad channels and calibrate artefact threshold

clear; clc;

%% Setup
restoredefaultpath
addpath(genpath('/Users/klauskrause/Documents/MATLAB/spm'))
spm('defaults','eeg')
spm_jobman('initcfg')

workdir = '/Users/klauskrause/Documents/MATLAB/ds004837_controls_spm';
cd(workdir);

subj = 'sub-2259A';
runname = 'run-01';

preqc_file = fullfile(workdir, ['flp_fhp_dbe_' subj '_' runname '.mat']);

%% Load pre-QC file
D = spm_eeg_load(preqc_file);

%% Save initial bad-channel set
initial_bad_labels = {'MEG1821'};

labels = chanlabels(D);
idx = find(ismember(labels, initial_bad_labels));

disp('Requested initial bad channels:')
disp(initial_bad_labels')

disp('Matched initial bad channels:')
disp(table(idx(:), labels(idx)', ...
    'VariableNames', {'Index','ChannelLabel'}))

if numel(idx) ~= numel(initial_bad_labels)
    error('Not all initial bad-channel labels were found. Check labels before saving.');
end

D = badchannels(D, ':', 0);
D = badchannels(D, idx, 1);
save(D);

disp('Initial bad channels saved:')
disp(chanlabels(D, badchannels(D))')

%% Threshold calibration
D = spm_eeg_load(preqc_file);

goodch = setdiff(1:D.nchannels, badchannels(D));
mx_trial = zeros(D.ntrials,1);

for tr = 1:D.ntrials
    dat = D(goodch,:,tr);
    mx_trial(tr) = max(abs(dat(:)));
end

disp('Percentiles of maximum absolute trial amplitude:')
disp(prctile(mx_trial,[90 95 97.5 99 99.5]))

disp(['Maximum value across trials: ' num2str(max(mx_trial))])

candidate_thresholds = round(prctile(mx_trial,[95 97.5 99 99.5]));

fprintf('\nPercentile-based candidate thresholds for %s\n', subj)
fprintf('Total trials: %d\n\n', D.ntrials)

for i = 1:numel(candidate_thresholds)
    th = candidate_thresholds(i);
    n_bad = sum(mx_trial > th);
    pct_bad = 100 * n_bad / numel(mx_trial);
    fprintf('Trials exceeding %d: %d / %d (%.2f%%)\n', ...
        th, n_bad, numel(mx_trial), pct_bad);
end
```

## Step 3: Run artefact rejection

```matlab
%% sub-2259A second-pass preprocessing: Step 3
% Run artefact rejection using 97.5th percentile threshold

clear; clc;

%% Setup
restoredefaultpath
addpath(genpath('/Users/klauskrause/Documents/MATLAB/spm'))
spm('defaults','eeg')
spm_jobman('initcfg')

workdir = '/Users/klauskrause/Documents/MATLAB/ds004837_controls_spm';
cd(workdir);

subj = 'sub-2259A';
runname = 'run-01';

preqc_file = fullfile(workdir, ['flp_fhp_dbe_' subj '_' runname '.mat']);
art_file   = fullfile(workdir, ['aflp_fhp_dbe_' subj '_' runname '.mat']);

%% Confirm saved bad channels before artefact rejection
D = spm_eeg_load(preqc_file);

disp('Saved bad channels before artefact rejection:')
disp(chanlabels(D, badchannels(D))')

%% Artefact rejection threshold
% Selected using approximately the 97.5th percentile of maximum absolute
% trial amplitude across currently good MEG channels.
threshold = 12427;

%% Run Tier 1 artefact rejection
S = [];
S.D = preqc_file;
S.mode = 'reject';
S.badchanthresh = 0.2;
S.append = true;

S.methods(1).channels = {'MEG'};
S.methods(1).fun = 'threshchan';
S.methods(1).settings.threshold = threshold;
S.methods(1).settings.excwin = 400;

S.prefix = 'a';

D_art = spm_eeg_artefact(S);

disp('Artefact-marked dataset created:')
disp(D_art)
disp(['Expected artefact-marked file: ' art_file])
```

## Step 4: Count bad trials overall and by condition

```matlab
%% sub-2259A second-pass preprocessing: Step 4
% Count bad trials overall and by condition

D_art = spm_eeg_load(art_file);

bt = badtrials(D_art);

if isnumeric(bt) && ~islogical(bt)
    tmp = false(D_art.ntrials,1);
    tmp(bt) = true;
    bt = tmp;
else
    bt = bt(:);
end

fprintf('\nTrial rejection summary for %s\n', subj)
fprintf('Threshold used: %d\n', threshold)
fprintf('Total trials: %d\n', D_art.ntrials)
fprintf('Bad trials: %d\n', sum(bt))
fprintf('Good trials: %d\n', sum(~bt))
fprintf('Percent rejected: %.2f%%\n', 100 * sum(bt) / D_art.ntrials)

conds = string(conditions(D_art))';
u = unique(conds);

bad_counts = zeros(numel(u),1);
good_counts = zeros(numel(u),1);
total_counts = zeros(numel(u),1);

for i = 1:numel(u)
    sel = conds == u(i);
    total_counts(i) = sum(sel);
    bad_counts(i) = sum(bt(sel));
    good_counts(i) = sum(sel & ~bt);
end

condition_table = table(u, total_counts, bad_counts, good_counts, ...
    'VariableNames', {'Condition','TotalTrials','BadTrials','GoodTrials'});

disp(condition_table)
```

